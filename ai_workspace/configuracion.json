                                                                   "leer_si":  "cambiar la estructura del código"
                                                               }
                 },
    "contenido_propio":  [

                         ],
    "extra":  "PLAN_ACTUAL.md se conserva intacto. En esta ejecución están autorizados Git local y commits, sin remoto ni push. No usar grabaciones reales en pruebas.",
    "exclusiones_backup":  [
                               ".venv",
                               "modelos",
                               "entrada",
                               "salida",
                               "graphify-out",
                               "__pycache__"
                           ]
}
